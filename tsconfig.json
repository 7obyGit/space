{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "types": ["node"],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": ["src/**/*"]
}
