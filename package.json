{
    "name": "@7obygit/space",
    "version": "1.3.0",
    "description": "A powerful CLI tool for managing dynamic VS Code workspaces. Switch contexts, manage environment variables, and attach files on the fly.",
    "main": "dist/index.js",
    "bin": {
        "space": "dist/index.js"
    },
    "scripts": {
        "prepare": "husky",
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "type-check": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/7obyGit/space.git"
    },
    "keywords": [
        "vscode",
        "workspace",
        "cli",
        "productivity",
        "context-switching",
        "environment-variables",
        "scratch-space"
    ],
    "author": "7obyGit",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist"
    ],
    "bugs": {
        "url": "https://github.com/7obyGit/space/issues"
    },
    "homepage": "https://github.com/7obyGit/space#readme",
    "devDependencies": {
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@types/marked-terminal": "^6.1.1",
        "@types/node": "^26.1.0",
        "prettier": "^3.9.4",
        "semantic-release": "^25.0.5",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2",
        "oxlint": "^1.74.0",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@7obygit/aw": "^0.6.0",
        "chalk": "^5.6.2",
        "clipanion": "^4.0.0-rc.4",
        "husky": "^9.1.7",
        "json5": "^2.2.3",
        "marked": "^18.0.7",
        "marked-terminal": "^7.3.0",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/npm",
            "@semantic-release/github"
        ]
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
